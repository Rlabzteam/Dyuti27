# ==============================================================================
# DYUTI 2027 Conference - Apache cPanel Configuration (.htaccess)
# Designed for subfolder hosting (/rcss/) and domain root hosting
# ==============================================================================

# 1. Block Direct Browser Access to .env, dotfiles, and sensitive extensions
<FilesMatch "^\.env|\.(env|sql|md|lock|git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Fallback Rewrite Rules for Sensitive Files
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule \.(sql|md|lock)$ - [F,L,NC]

    # 2. Friendly Route Rewrites
    RewriteRule ^register/?$ registration.html [L,QSA]
    RewriteRule ^contactus/?$ contact.html [L,QSA]

    # 3. Direct API Endpoint Rewrites (extensionless -> .php)
    RewriteRule ^api/test_mail(\.php)?$ - [F,L,NC]
    RewriteRule ^api/migrate_db(\.php)?$ - [F,L,NC]
    RewriteRule ^api/migrate_email_sent(\.php)?$ - [F,L,NC]
    RewriteRule ^api/create_payment_order/?$ api/create_payment_order.php [L,QSA]
    RewriteRule ^api/save_registration/?$ api/save_registration.php [L,QSA]
    RewriteRule ^api/send_registration_notification/?$ api/send_registration_notification.php [L,QSA]
    RewriteRule ^api/send_contact/?$ api/send_contact.php [L,QSA]

    # 4. Clean HTML URLs (allow omitting .html extension)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L,QSA]
</IfModule>

# Prevent directory listing
Options -Indexes

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
